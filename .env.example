# ---- EVA environment ----
# Database — Postgres (Neon recommended on Vercel).
# DATABASE_URL: pooled connection string (used at runtime). For Neon append ?pgbouncer=true&connection_limit=1
# DIRECT_URL:   direct (non-pooled) connection string, used by `prisma db push` / migrations.
# When you add the Neon integration on Vercel these are injected automatically.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth — REQUIRED. Use a long random string in production (e.g. `openssl rand -base64 48`)
JWT_SECRET="dev-only-change-me-to-a-long-random-string"

# AI service. Empty = use the built-in in-process TypeScript AI layer.
# Point to a real Python/FastAPI service later without changing the backend contract.
AI_SERVICE_URL=""

# IoT ingestion. Empty = in-process simulator. Point to an MQTT bridge later.
MQTT_URL=""

# Shared key for external telemetry generators / device gateways.
# Set this before running tools/telemetry_generator.py.
IOT_INGEST_API_KEY="change-me-to-a-long-random-device-key"

# Business rules (all optional — sensible defaults applied in code)
RENTAL_ENDING_WARNING_MINUTES=15
OVERDUE_GRACE_MINUTES=10
BATTERY_CRITICAL_TEMPERATURE=55
BATTERY_LOW_VOLTAGE=34
THEFT_GEOFENCE_RADIUS_KM=8
